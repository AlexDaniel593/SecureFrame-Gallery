# ============================================
# SecureFrame Gallery - Variables de entorno raíz
# ============================================
# Este archivo es usado por Docker Compose (docker-compose.yml)
# Se carga automáticamente al ejecutar: docker compose up

# --- MinIO (Almacenamiento de objetos) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET_CLEAN=clean-images
MINIO_BUCKET_QUARANTINE=quarantine

# --- PostgreSQL (Base de datos del frontend) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=admin123
POSTGRES_DB=database_name
