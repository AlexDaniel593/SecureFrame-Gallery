datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  albums    Album[]
}

enum Role {
  USER
  SUPERVISOR
  ADMIN
}

enum Privacy {
  PUBLIC
  PRIVATE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model Album {
  id          String   @id @default(uuid())
  title       String
  description String?
  privacy    Privacy  @default(PRIVATE)
  status      Status   @default(PENDING)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  images      Image[]
  createdAt  DateTime @default(now())
}

model Image {
  id          String       @id @default(uuid())
  filename    String
  minioPath   String
  status      ImageStatus  @default(ANALYZING)
  stegoResult Json?
  albumId     String
  album       Album        @relation(fields: [albumId], references: [id])
}

enum ImageStatus {
  ANALYZING
  CLEAN
  SUSPICIOUS
  QUARANTINED
  APPROVED
  REJECTED
}